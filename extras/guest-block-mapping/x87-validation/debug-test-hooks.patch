+#if C_HEAVY_DEBUGGER && defined(X87_DEBUG_TEST_HOOK)
+static CBreakpoint* x87_test_match = nullptr;
+static CBreakpoint* x87_test_miss = nullptr;
+static bool x87_test_done = false;
+void DEBUG_X87TestArm(PhysPt address)
+{
+ if (x87_test_done || !std::getenv("DOSBOX_X87_DEBUG_TEST")) return;
+ x87_test_done = true;
+ x87_test_match = new CBreakpoint();
+ x87_test_match->SetAddress(address);
+ x87_test_match->SetType(BKPNT_MEMORY_READ);
+ x87_test_match->FlagMemoryAsUnread();
+ x87_test_miss = new CBreakpoint();
+ x87_test_miss->SetAddress(address + 0x10000000);
+ x87_test_miss->SetType(BKPNT_MEMORY_READ);
+ x87_test_miss->FlagMemoryAsUnread();
+ x87_test_match->Activate(true);
+ x87_test_miss->Activate(true);
+ BPoints.push_back(x87_test_match);
+ BPoints.push_back(x87_test_miss);
+}
+void DEBUG_X87TestVerify()
+{
+ if (!x87_test_match) return;
+ const bool match = x87_test_match->WasMemoryRead();
+ const bool unrelated = x87_test_miss->WasMemoryRead();
+ const bool stop = DEBUG_HeavyIsBreakpoint();
+ std::fprintf(stderr, "X87_DEBUG_TEST match=%d unrelated=%d stop=%d\n", match, unrelated, stop);
+ BPoints.remove(x87_test_match); BPoints.remove(x87_test_miss);
+ delete x87_test_match; delete x87_test_miss;
+ x87_test_match = x87_test_miss = nullptr;
+}
